# Run locally: cp .env.example .env (Windows PowerShell: Copy-Item .env.example .env)
PORT=3000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
SESSION_SECRET=REPLACE_WITH_RANDOM_96_CHAR_HEX
SCIM_BEARER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_96_CHAR_HEX
# Copy the Login URL and Entra Identifier from Enterprise app > Single sign-on > SAML.
ENTRA_LOGIN_URL=
ENTRA_ISSUER=
# Paste the full downloaded Base64 .cer text (-----BEGIN CERTIFICATE-----...) into this variable.
# SAML entity ID is automatically APP_BASE_URL/saml/metadata. No SAML_ISSUER variable.
# Render: paste PEM with real newlines, or escaped \n. Do NOT Base64 encode PEM again.
ENTRA_CERT_BASE64=
# Local JSON database. Render Free's filesystem is ephemeral; see README.
DATA_DIR=./data
